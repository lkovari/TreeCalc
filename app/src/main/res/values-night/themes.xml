<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Treecalc" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/splash_background_night</item>
        <item name="android:navigationBarColor">@color/splash_background_night</item>
        <item name="android:windowBackground">@color/splash_background_night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.Treecalc.Splash" parent="Theme.Treecalc">
        <item name="android:statusBarColor">@color/splash_hero</item>
        <item name="android:navigationBarColor">@color/splash_hero</item>
        <item name="android:windowBackground">@color/splash_hero</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_hero</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">@color/splash_hero</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">0</item>
    </style>
</resources>
